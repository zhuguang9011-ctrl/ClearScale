{
  "name": "clearscale",
  "version": "1.0.0",
  "description": "本地 AI 图片高清放大桌面工具",
  "main": "src/main.js",
  "author": "zhuguang9011-ctrl",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.js",
    "engine:win": "node scripts/prepare-engine.js",
    "dist:win": "npm run engine:win && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.clearscale.desktop",
    "productName": "ClearScale 清晰放大",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "shortcutName": "ClearScale 清晰放大"
    }
  }
}
